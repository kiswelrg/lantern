#!/usr/bin/env bash
# lantern — manage the LAN docs/app server. See README.md.
set -euo pipefail

LANTERN_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SITES="$LANTERN_ROOT/sites"
APPS="$LANTERN_ROOT/apps"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
APP_PORT_MIN=8101 # where apps listen, on 127.0.0.1
APP_PORT_MAX=8199
LAN_PORT_MIN=8201 # where --own-port apps are served to the LAN
LAN_PORT_MAX=8299
MIN_CADDY="2.8.0" # readFile in templates

SKILL_LINK="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/lantern"
BIN_LINK="$HOME/.local/bin/lantern"
# Files add-app/add-tunnel/add-proxy write; rm-app refuses to delete anything else without --force.
APP_SCAFFOLD=(run.sh app.env route.caddy port.caddy README.md)

# Local settings (lantern.env, gitignored): LANTERN_PORT, LANTERN_CONTENT.
if [[ -f "$LANTERN_ROOT/lantern.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$LANTERN_ROOT/lantern.env"
  set +a
fi
LANTERN_PORT="${LANTERN_PORT:-8080}"
# Content repo for pages and tools that belong to no other repo (sibling of lantern by default).
LANTERN_CONTENT="${LANTERN_CONTENT:-$(dirname "$LANTERN_ROOT")/lantern-content}"
export LANTERN_ROOT LANTERN_PORT LANTERN_CONTENT

# ---------- helpers ----------

die() { printf 'lantern: %s\n' "$*" >&2; exit 1; }

caddy_bin() { command -v caddy 2>/dev/null || true; }

host_addr() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  printf '%s' "${ip:-localhost}"
}

url_for() { printf 'http://%s:%s/%s/' "$(host_addr)" "$LANTERN_PORT" "$1"; }

# LAN URL of a site or app: /<name>/ on the main port, or an --own-port app's own port.
public_url() {
  local lan=""
  [[ -d "$APPS/$1" ]] && lan="$(lan_port "$APPS/$1")"
  if [[ -n "$lan" ]]; then printf 'http://%s:%s/' "$(host_addr)" "$lan"; else url_for "$1"; fi
}

valid_name() { [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; }

name_taken() { [[ -e "$SITES/$1" || -L "$SITES/$1" || -e "$APPS/$1" ]]; }

unit_active() { systemctl --user is-active --quiet "$1" 2>/dev/null; }

# KEY's value in an app's app.env (empty if missing).
app_var() { # dir, key
  [[ -f "$1/app.env" ]] || return 0
  sed -n "s/^[[:space:]]*$2=[\"']\{0,1\}\([^\"'[:space:]]*\).*/\1/p" "$1/app.env" | tail -n 1
}

# Numeric KEY from an app's app.env (empty if missing).
app_num() { # dir, key
  [[ -f "$1/app.env" ]] || return 0
  sed -n "s/^[[:space:]]*$2=[\"']\{0,1\}\([0-9]*\).*/\1/p" "$1/app.env" | tail -n 1
}

app_port() { app_num "$1" PORT; }  # where the app listens on 127.0.0.1
lan_port() { app_num "$1" LAN_PORT; } # set for --own-port apps

# process (run.sh starts a server), tunnel (run.sh is an ssh forward) or proxy (nothing runs).
app_kind() {
  if [[ -n "$(app_var "$1" UPSTREAM)" ]]; then
    echo proxy
  elif [[ -n "$(app_var "$1" TUNNEL_TO)" ]]; then
    echo tunnel
  else
    echo process
  fi
}

# Where Caddy sends an app's requests, per app.env.
app_upstream() {
  local up port
  up="$(app_var "$1" UPSTREAM)"
  port="$(app_port "$1")"
  if [[ -n "$up" ]]; then printf '%s' "$up"; elif [[ -n "$port" ]]; then printf '127.0.0.1:%s' "$port"; fi
}

# Upstream in route.caddy's import line (empty if customised).
route_upstream() {
  [[ -f "$1/route.caddy" ]] || return 0
  awk '$1 != "import" { next }
    $2 == "lantern-app" || $2 == "lantern-app-keep" { u = "127.0.0.1:" $4 }
    $2 == "lantern-proxy" || $2 == "lantern-proxy-keep" { u = $4 }
    $2 == "lantern-own-port" { u = $5 }
    END { print u }' "$1/route.caddy"
}

# LAN port in a route.caddy / port.caddy own-port import line (empty if none).
caddy_lan_port() { # file
  [[ -f "$1" ]] || return 0
  awk '$1 == "import" && ($2 == "lantern-own-port" || $2 == "lantern-own-port-site") { p = $4 } END { print p }' "$1"
}

valid_hostport() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?:[0-9]{1,5}$ ]]; }

app_dirs() {
  local d
  for d in "$APPS"/*/; do
    [[ -d "$d" ]] && printf '%s\n' "${d%/}"
  done
  return 0
}

listening_ports() { ss -Htln 2>/dev/null | awk '{ sub(/.*:/, "", $4); print $4 }'; }

port_listening() { listening_ports | grep -qx "$1"; }

next_free_port() { # min, max
  local used p d
  used=" $LANTERN_PORT $(listening_ports | tr '\n' ' ') "
  while read -r d; do used+="$(app_port "$d") $(lan_port "$d") "; done < <(app_dirs)
  for ((p = $1; p <= $2; p++)); do
    [[ "$used" == *" $p "* ]] || { echo "$p"; return; }
  done
  die "no free port in $1-$2"
}

# Validate the Caddyfile with the same env the service uses. Prints errors only.
validate() {
  local caddy out
  caddy="$(caddy_bin)"
  [[ -n "$caddy" ]] || die "caddy is not installed (see README → Setup)"
  if ! out="$("$caddy" validate --config "$LANTERN_ROOT/Caddyfile" --adapter caddyfile 2>&1)"; then
    printf '%s\n' "$out" | grep -E '"level":"error"|^Error' >&2 || printf '%s\n' "$out" >&2
    return 1
  fi
}

version_ge() { [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" == "$2" ]]; }

# "deploy-notes" -> "Deploy notes"
title_for() { local t="${1//-/ }"; printf '%s' "${t^}"; }

# Stub README with frontmatter: the landing page shows its title and description.
write_readme() { # file, name
  cat > "$1" <<EOF
---
title: $(title_for "$2")
# description: One line shown on the lantern landing page.
---
# $(title_for "$2")
EOF
}

# Set KEY=value in lantern.env, keeping its other lines.
set_local() { # key, value
  local f="$LANTERN_ROOT/lantern.env"
  [[ -f "$f" ]] || printf '# Local lantern settings (gitignored).\n' > "$f"
  if grep -q "^$1=" "$f"; then
    sed -i "s|^$1=.*|$1=$2|" "$f"
  else
    printf '%s=%s\n' "$1" "$2" >> "$f"
  fi
}

# Create the content repo on first use; print its path.
ensure_content() {
  if [[ ! -d "$LANTERN_CONTENT" ]]; then
    mkdir -p "$LANTERN_CONTENT/pages" "$LANTERN_CONTENT/apps"
    cat > "$LANTERN_CONTENT/README.md" <<'EOF'
# lantern content

Pages and small tools served by lantern that don't belong to any other repo.

- `pages/<name>/`: a site, linked from lantern's `sites/<name>` (`lantern new-site <name>`)
- `apps/<name>/`: code for a self-contained app; lantern's `apps/<name>/run.sh` starts it

Nothing here is served by itself: only folders linked from lantern's `sites/` are visible on the LAN.
EOF
    touch "$LANTERN_CONTENT/pages/.gitkeep" "$LANTERN_CONTENT/apps/.gitkeep"
    if command -v git >/dev/null; then git -C "$LANTERN_CONTENT" init -q; fi
    echo "created content repo $LANTERN_CONTENT" >&2
  fi
  printf '%s\n' "$LANTERN_CONTENT"
}

# Symlink $2 -> $1 unless a real file is in the way.
link_tool() { # target, link
  if [[ -e "$2" && ! -L "$2" ]]; then
    echo "skipped $2: a real file is in the way" >&2
    return 0
  fi
  mkdir -p "$(dirname "$2")"
  ln -sfn "$1" "$2"
  echo "linked $2 -> $1"
}

# What linking a folder would put on the LAN: file count, size, risky-looking files.
scan_exposure() { # dir
  local dir=$1 files risky links
  local -a prune=( \( -name '.*' -o -name node_modules -o -name __pycache__ \) -prune -o )
  files="$(find "$dir" -mindepth 1 "${prune[@]}" -type f -print | wc -l)"
  printf 'exposes %s file(s), %s, under %s\n' "$files" \
    "$(du -sh --exclude='.?*' --exclude=node_modules --exclude=__pycache__ "$dir" 2>/dev/null | cut -f1)" "$dir"
  echo "  (dotfiles, node_modules/ and __pycache__/ stay hidden)"
  risky="$(find "$dir" -mindepth 1 "${prune[@]}" -type f \( \
      -iname '*.pem' -o -iname '*.key' -o -iname '*.p12' -o -iname '*.pfx' -o -iname '*.jks' \
      -o -iname '*.keystore' -o -iname '*.kdbx' -o -iname 'id_rsa*' -o -iname 'id_ed25519*' \
      -o -iname 'id_ecdsa*' -o -iname '*.env' -o -iname '*.tfstate' -o -iname '*.tfvars' \
      -o -iname 'kubeconfig*' -o -iname '*.ovpn' -o -iname '*.sqlite' -o -iname '*.sqlite3' -o -iname '*.db' \
      -o \( \( -iname '*secret*' -o -iname '*credential*' -o -iname '*token*' -o -iname '*passw*' \) \
            ! -iname '*.md' ! -iname '*.html' \) \) -printf '%P\n' | sort)"
  if [[ -n "$risky" ]]; then
    echo "risky-looking files (would be readable on the LAN):"
    printf '%s\n' "$risky" | head -n 25 | sed 's/^/  /'
    (($(printf '%s\n' "$risky" | wc -l) > 25)) && echo "  …"
  fi
  # Text files under 1 MB with a URL carrying a password (rtsp://user:pass@host, …).
  risky="$(cd "$dir" && find . -mindepth 1 "${prune[@]}" -type f -size -1024k -print0 |
    xargs -0 -r grep -IlE '[[:alpha:]][[:alnum:]+.-]*://[^/:@[:space:]]+:[^/@[:space:]]+@' 2>/dev/null |
    sed 's|^\./||' | sort || true)"
  if [[ -n "$risky" ]]; then
    echo "files with credentials in a URL (scheme://user:password@host):"
    printf '%s\n' "$risky" | head -n 25 | sed 's/^/  /'
  fi
  links="$(find "$dir" -mindepth 1 "${prune[@]}" -type l -printf '%P -> %l\n' | head -n 10)"
  if [[ -n "$links" ]]; then
    echo "symlinks inside (followed when served):"
    printf '%s\n' "$links" | sed 's/^/  /'
  fi
  return 0
}

# Link sites/<name> -> dir and print its URL.
link_site() { # name, dir
  ln -s "$2" "$SITES/$1"
  echo "added $1 -> $2"
  url_for "$1"; echo
}

caddy_version() { "$1" version 2>/dev/null | awk '{ sub(/^v/, "", $1); print $1 }'; }

# ---------- commands ----------

cmd_add_site() {
  local usage="usage: lantern add-site <name> <path> [--dry-run] [--whole-repo]"
  local dry=0 whole=0 args=() a
  for a in "$@"; do
    case "$a" in
      --dry-run) dry=1 ;;
      --whole-repo) whole=1 ;;
      -*) die "$usage" ;;
      *) args+=("$a") ;;
    esac
  done
  [[ ${#args[@]} -eq 2 ]] || die "$usage"
  local name=${args[0]} path=${args[1]} target
  valid_name "$name" || die "site names are lowercase-kebab (a-z, 0-9, -): '$name'"
  name_taken "$name" && die "'$name' is already a site or app"
  [[ -d "$path" ]] || die "not a directory: $path"
  target="$(cd "$path" && pwd)"
  [[ "$target" == / || "$target" == "$HOME" ]] && die "refusing to serve all of $target"
  if [[ -e "$target/.git" ]] && ((!whole)); then
    die "$target is a whole repo: link its docs folder instead, or pass --whole-repo"
  fi
  scan_exposure "$target"
  if ((dry)); then
    echo "dry run: would add $name -> $target"
    return 0
  fi
  link_site "$name" "$target"
}

cmd_new_site() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: lantern new-site <name> [dir]"
  local name=$1 dir=${2:-}
  valid_name "$name" || die "site names are lowercase-kebab (a-z, 0-9, -): '$name'"
  name_taken "$name" && die "'$name' is already a site or app"
  [[ -n "$dir" ]] || dir="$(ensure_content)/pages/$name"
  if [[ -e "$dir" ]]; then
    [[ -d "$dir" ]] || die "not a directory: $dir"
    [[ -z "$(ls -A "$dir")" ]] || die "$dir is not empty: use add-site to serve an existing folder"
  fi
  mkdir -p "$dir"
  dir="$(cd "$dir" && pwd)"
  write_readme "$dir/README.md" "$name"
  echo "created $dir/README.md"
  link_site "$name" "$dir"
}

cmd_content() {
  [[ $# -eq 0 ]] || die "usage: lantern content"
  ensure_content
}

cmd_rm_site() {
  [[ $# -eq 1 ]] || die "usage: lantern rm-site <name>"
  local link="$SITES/$1"
  [[ -L "$link" ]] || die "no site symlink named '$1'"
  rm -- "$link"
  echo "removed $1 (the target folder is untouched)"
}

# Mount flags shared by add-app, add-tunnel and add-proxy. Sets the caller's `mount`
# (strip, keep or own) and `args` (the other arguments).
parse_mount() { # usage, args...
  local usage=$1 a
  shift
  mount=strip args=()
  for a in "$@"; do
    case "$a" in
      --keep-prefix) [[ "$mount" == strip ]] || die "$usage"; mount=keep ;;
      --own-port) [[ "$mount" == strip ]] || die "$usage"; mount=own ;;
      -*) die "$usage" ;;
      *) args+=("$a") ;;
    esac
  done
}

new_app_name() {
  valid_name "$1" || die "app names are lowercase-kebab (a-z, 0-9, -): '$1'"
  name_taken "$1" && die "'$1' is already a site or app"
  return 0
}

cmd_add_app() {
  local usage="usage: lantern add-app <name> [port] [--keep-prefix | --own-port]"
  local mount args
  parse_mount "$usage" "$@"
  [[ ${#args[@]} -ge 1 && ${#args[@]} -le 2 ]] || die "$usage"
  local name=${args[0]} port=${args[1]:-} d
  new_app_name "$name"
  if [[ -n "$port" ]]; then
    [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1024 && port <= 65535)) || die "bad port: $port"
    while read -r d; do
      [[ "$(app_port "$d")" == "$port" || "$(lan_port "$d")" == "$port" ]] &&
        die "port $port is already used by app $(basename "$d")"
    done < <(app_dirs)
  else
    port="$(next_free_port "$APP_PORT_MIN" "$APP_PORT_MAX")"
  fi
  scaffold_app "$name" process "$mount" "$port"
}

cmd_add_tunnel() {
  local usage="usage: lantern add-tunnel <name> <ssh-host> <host:port> [--keep-prefix | --own-port]"
  local mount args
  parse_mount "$usage" "$@"
  [[ ${#args[@]} -eq 3 ]] || die "$usage"
  local name=${args[0]} via=${args[1]} to=${args[2]} port
  new_app_name "$name"
  [[ "$via" =~ ^[^-[:space:]][^[:space:]]*$ ]] ||
    die "bad ssh host: '$via' (user@host, ssh://user@host:port or a ~/.ssh/config alias)"
  valid_hostport "$to" || die "the tunnel target is <host>:<port>, as the ssh host sees it: '$to'"
  port="$(next_free_port "$APP_PORT_MIN" "$APP_PORT_MAX")"
  scaffold_app "$name" tunnel "$mount" "$port" "$to" "$via"
}

cmd_add_proxy() {
  local usage="usage: lantern add-proxy <name> <host:port> [--keep-prefix | --own-port]"
  local mount args
  parse_mount "$usage" "$@"
  [[ ${#args[@]} -eq 2 ]] || die "$usage"
  local name=${args[0]} up=${args[1]}
  new_app_name "$name"
  up="${up#http://}" up="${up%/}"
  up="${up/#localhost:/127.0.0.1:}"
  valid_hostport "$up" || die "the upstream is <host>:<port> of a plain-HTTP service: '${args[1]}'"
  scaffold_app "$name" proxy "$mount" "" "$up"
}

# Write apps/<name>/: app.env, route.caddy (+ port.caddy when it has its own port),
# README.md and, unless nothing runs (proxy), run.sh. Then reload and print next steps.
scaffold_app() { # name, kind, mount, port, target (tunnel/proxy), ssh host (tunnel)
  local name=$1 kind=$2 mount=$3 port=$4 target=${5:-} via=${6:-}
  local dir="$APPS/$name" upstream=$target lan="" base_path="/$name/"
  [[ "$kind" == proxy ]] || upstream="127.0.0.1:$port"
  if [[ "$mount" == own ]]; then
    lan="$(next_free_port "$LAN_PORT_MIN" "$LAN_PORT_MAX")"
    base_path=/
  fi
  mkdir "$dir"

  case "$kind" in
    process)
      cat > "$dir/app.env" <<EOF
# Port the app listens on (127.0.0.1 only). Must match route.caddy.
PORT=$port
EOF
      ;;
    tunnel)
      cat > "$dir/app.env" <<EOF
# Local end of the ssh tunnel (127.0.0.1 only). Must match route.caddy.
PORT=$port
# run.sh forwards PORT through the ssh host TUNNEL_VIA (user@host, ssh://user@host:port
# or a ~/.ssh/config alias) to TUNNEL_TO (host:port, as the ssh host sees it).
TUNNEL_VIA=$via
TUNNEL_TO=$target
EOF
      ;;
    proxy)
      cat > "$dir/app.env" <<EOF
# What lantern proxies to: host:port of a plain-HTTP service it doesn't start, on this
# machine (127.0.0.1) or elsewhere, so there is no unit. Must match route.caddy.
UPSTREAM=$target
EOF
      [[ "$target" == 127.0.0.1:* ]] || printf '%s
' \
        "# Caddy reaches it through HTTP_PROXY from lantern.env unless NO_PROXY covers its host." >> "$dir/app.env"
      ;;
  esac
  if [[ -n "$lan" ]]; then
    cat >> "$dir/app.env" <<EOF
# Port the app is served on to the LAN, at "/". Must match route.caddy and port.caddy.
LAN_PORT=$lan
EOF
    [[ "$kind" != process ]] || printf '# The app sits at the root of its own port.\nBASE_PATH=/\n' >> "$dir/app.env"
  fi

  # Anything on 127.0.0.1 gets the visitor's Host header; a service elsewhere gets its own.
  local snippet=lantern-app arg=$port to_what="this app" host="{hostport}"
  if [[ "$kind" == proxy ]]; then
    to_what=$upstream arg=${upstream#127.0.0.1:}
    [[ "$upstream" == 127.0.0.1:* ]] || snippet=lantern-proxy arg=$upstream host="{upstream_hostport}"
  fi
  if [[ "$mount" == own ]]; then
    cat > "$dir/route.caddy" <<EOF
# On lantern's main port: /$name/ redirects to port $lan, where the app is served
# (port.caddy), and HEAD /_status/$name feeds the landing page's up/down badge.
# See the lantern-own-port snippet in the Caddyfile.
import lantern-own-port $name $lan $upstream ${host/#\{hostport\}/\{host\}:$lan}
EOF
    cat > "$dir/port.caddy" <<EOF
# Serves $to_what on its own port $lan, at "/" (see lantern-own-port-site in the Caddyfile).
import lantern-own-port-site $name $lan $upstream $host
EOF
  else
    [[ "$mount" == strip ]] || snippet+=-keep
    cat > "$dir/route.caddy" <<EOF
# Proxies /$name/ to $to_what (see the $snippet snippet in the Caddyfile).
# Replace with custom Caddy directives if the app needs something else.
import $snippet $name $arg
EOF
  fi

  write_readme "$dir/README.md" "$name"

  local prefix_note
  case "$mount" in
    strip) prefix_note="# The app is served under /$name/ and Caddy strips that prefix, so use relative
# URLs (or build absolute ones from \$BASE_PATH / the X-Forwarded-Prefix header)." ;;
    keep) prefix_note="# The app is served under /$name/ and Caddy passes the full path through, so
# the app itself must serve everything under \$BASE_PATH (e.g. Streamlit
# --server.baseUrlPath, marimo --base-url, Dash url_base_pathname)." ;;
    own) prefix_note="# The app is served at the root of its own LAN port ($lan), so absolute URLs
# work; /$name/ on lantern's main port redirects there." ;;
  esac
  case "$kind" in
    process)
      cat > "$dir/run.sh" <<EOF
#!/usr/bin/env bash
# Started by lantern-app@$name.service with PORT (from app.env), APP_NAME and
# BASE_PATH=$base_path in the environment. Listen on 127.0.0.1:\$PORT.
#
$prefix_note
#
# Python: use uv, e.g.
#   exec uv run --script app.py                          # PEP 723 single file
#   exec uv run --project /path/to/repo flask --app pkg run --port "\$PORT"
set -euo pipefail
cd "\$(dirname "\$0")"

# Placeholder: serves this folder. Replace with your server.
exec uv run --no-project python -m http.server "\$PORT" --bind 127.0.0.1
EOF
      ;;
    tunnel)
      cat > "$dir/run.sh" <<EOF
#!/usr/bin/env bash
# Started by lantern-app@$name.service: an ssh tunnel from 127.0.0.1:\$PORT through
# \$TUNNEL_VIA to \$TUNNEL_TO (all three in app.env).
#
$prefix_note
#
# The unit has no terminal and no ssh-agent, so key login must work without a prompt:
#   ssh -o BatchMode=yes $via true
# ~/.ssh/config applies. When the link dies, ServerAlive* makes ssh exit and systemd
# starts it again.
set -euo pipefail
exec ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new \\
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \\
  -L "127.0.0.1:\$PORT:\$TUNNEL_TO" "\$TUNNEL_VIA"
EOF
      ;;
  esac
  [[ ! -f "$dir/run.sh" ]] || chmod +x "$dir/run.sh"

  local how=""
  case "$mount" in keep) how=", prefix kept" ;; own) how=", own port $lan" ;; esac
  case "$kind" in
    process) echo "created apps/$name/ (port $port$how)" ;;
    tunnel) echo "created apps/$name/ (ssh tunnel on port $port to $target via $via$how)" ;;
    proxy) echo "created apps/$name/ (proxy to $upstream$how)" ;;
  esac
  if unit_active lantern; then
    cmd_reload >/dev/null &&
      if [[ -n "$lan" ]]; then echo "caddy reloaded: port $lan and /$name/ are routed"; else echo "caddy reloaded: /$name/ is routed"; fi
  fi
  local enable="systemctl --user enable --now lantern-app@$name"
  case "$kind" in
    process) printf '\nnext:\n  1. edit apps/%s/run.sh to start your server on $PORT\n  2. %s\n' "$name" "$enable" ;;
    tunnel) printf '\nnext:\n  1. ssh -o BatchMode=yes %s true   must work without a prompt (else ssh-copy-id)\n  2. %s\n' "$via" "$enable" ;;
    proxy) unit_active lantern || printf '\nnext:\n' ;;
  esac
  if ! unit_active lantern; then
    if [[ "$kind" == proxy ]]; then echo "  1. lantern reload   (lantern isn't running yet)"; else echo "  3. lantern reload   (lantern isn't running yet)"; fi
  fi
  echo
  public_url "$name"; echo
}

cmd_rm_app() {
  local usage="usage: lantern rm-app <name> [--force]"
  local force=0 args=() a
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      -*) die "$usage" ;;
      *) args+=("$a") ;;
    esac
  done
  [[ ${#args[@]} -eq 1 ]] || die "$usage"
  local name=${args[0]} dir="$APPS/${args[0]}" extra f known kind
  [[ -n "$name" && "$name" != */* && -d "$dir" ]] || die "no app named '$name'"
  kind="$(app_kind "$dir")"
  extra=""
  for f in "$dir"/* "$dir"/.[!.]*; do
    [[ -e "$f" || -L "$f" ]] || continue
    known=0
    for a in "${APP_SCAFFOLD[@]}"; do [[ "$(basename "$f")" == "$a" ]] && known=1; done
    ((known)) || extra+=" $(basename "$f")"
  done
  if [[ -n "$extra" ]] && ((!force)); then
    die "apps/$name has files add-app didn't create:$extra (move them out, or pass --force)"
  fi
  systemctl --user disable --now "lantern-app@$name" >/dev/null 2>&1 || true
  systemctl --user reset-failed "lantern-app@$name" >/dev/null 2>&1 || true
  rm -rf -- "$dir"
  if [[ "$kind" == proxy ]]; then echo "removed apps/$name"; else echo "removed apps/$name (unit stopped and disabled)"; fi
  if unit_active lantern; then
    cmd_reload >/dev/null && echo "caddy reloaded: $name is no longer routed"
  fi
}

# Live check of one site or app (or one page of it) through the running lantern, at its
# LAN address as colleagues reach it (apps may check the Host header): the page answers,
# Markdown is rendered, and the page's same-origin links resolve.
cmd_check() {
  [[ $# -eq 1 ]] || die "usage: lantern check <name>[/<page>]"
  local name=${1%%/*} sub="" addr fails=0 warns=0 port state main
  addr="$(host_addr)" main="http://$addr:$LANTERN_PORT"
  [[ "$1" == */* ]] && sub="${1#*/}"
  # base: the origin the page is served from; prefix: the path it lives under there
  # (empty for an app on its own port, which owns "/").
  local base=$main prefix="/$name" app=0 lan=""
  local g="" y="" r="" z=""
  [[ -t 1 ]] && g=$'\e[32m' y=$'\e[33m' r=$'\e[31m' z=$'\e[0m'
  ok() { printf '  %s✓%s %s\n' "$g" "$z" "$*"; }
  warn() { printf '  %s!%s %s\n' "$y" "$z" "$*"; warns=$((warns + 1)); }
  fail() { printf '  %s✗%s %s\n' "$r" "$z" "$*"; fails=$((fails + 1)); }

  port_listening "$LANTERN_PORT" || die "nothing listening on port $LANTERN_PORT: is lantern running?"
  if [[ -d "$APPS/$name" ]]; then
    local d="$APPS/$name" kind
    app=1 kind="$(app_kind "$d")" lan="$(lan_port "$d")"
    echo "App $name"
    if [[ "$kind" == proxy ]]; then
      ok "proxies to $(app_upstream "$d") (lantern doesn't run it)"
    else
      port="$(app_port "$d")"
      state="$(systemctl --user is-active "lantern-app@$name" 2>/dev/null || true)"
      if [[ -n "$port" ]] && port_listening "$port"; then
        ok "listening on $port (unit: ${state:-unknown})$([[ "$kind" != tunnel ]] || echo ", ssh tunnel to $(app_var "$d" TUNNEL_TO)")"
      else
        fail "nothing listening on ${port:-?} (unit: ${state:-unknown}; journalctl --user -u lantern-app@$name)"
        [[ "$kind" != tunnel ]] ||
          echo "    the tunnel needs key login without a prompt: ssh -o BatchMode=yes $(app_var "$d" TUNNEL_VIA) true"
      fi
    fi
    if [[ -n "$lan" ]]; then
      local loc
      if port_listening "$lan"; then ok "own port $lan listening"; else fail "nothing listening on own port $lan (lantern reload)"; fi
      loc="$(curl -s --noproxy '*' -o /dev/null --max-time 5 -w '%{redirect_url}' "$main/$name/" || true)"
      if [[ "$loc" == "http://$addr:$lan/" ]]; then
        ok "/$name/ redirects to port $lan"
      else
        fail "/$name/ should redirect to port $lan, got ${loc:-no redirect}"
      fi
      base="http://$addr:$lan" prefix=""
    fi
    # The landing page's badge: answers below 500, and never asks the browser for a login.
    local shead scode
    shead="$(curl -s --noproxy '*' -o /dev/null -I -D - --max-time 15 "$main/_status/$name" || true)"
    scode="$(awk 'NR == 1 { print $2 }' <<<"$shead")"
    if [[ ! "$scode" =~ ^[1-4] ]]; then
      fail "badge: HEAD /_status/$name → ${scode:-no response}"
    elif grep -qi '^www-authenticate:' <<<"$shead"; then
      fail "badge: HEAD /_status/$name → $scode with WWW-Authenticate (the landing page would ask for a login)"
    else
      ok "badge: HEAD /_status/$name → $scode"
    fi
  elif [[ -L "$SITES/$name" || -e "$SITES/$name" ]]; then
    echo "Site $name"
    if [[ -e "$SITES/$name" ]]; then ok "-> $(readlink -f "$SITES/$name")"; else fail "broken symlink -> $(readlink "$SITES/$name")"; fi
  else
    die "no site or app named '$name'"
  fi

  # The page's URL path. Apps may redirect (to a login page, say): follow, then check there.
  local page="$prefix/$sub" out code ctype eff body shown follow=()
  ((app)) && follow=(-L --max-redirs 5)
  out="$(curl -s --noproxy '*' "${follow[@]}" --max-time 15 -w '\n%{http_code}|%{content_type}|%{url_effective}' "$base$page" || true)"
  IFS='|' read -r code ctype eff <<<"$(tail -n 1 <<<"$out")"
  body="$(sed '$d' <<<"$out")"
  shown=$page
  if [[ -n "$eff" && "$eff" != "$base$page" ]]; then
    local rest="${eff#*://}"
    if [[ "http://${rest%%/*}" != "$base" ]]; then
      shown="$page → $eff" body=""
      warn "redirects away from lantern, to $eff"
    else
      page="/${rest#*/}"
      [[ "$rest" == */* ]] || page=/
      shown="$shown → $page"
      [[ -z "$prefix" || "$page" == "$prefix/"* ]] ||
        warn "redirect to $page leaves $prefix/ (an app that needs the root: --own-port)"
    fi
  fi
  if [[ "$code" == 200 ]]; then
    ok "GET $shown → 200 ${ctype%%;*}"
  elif [[ "$code" == 401 ]] && ((app)); then
    ok "GET $shown → 401: the app asks for a login (links not checked)"
  else
    fail "GET $shown → ${code:-no response}$([[ "$code" == 502 ]] && echo " (app not reachable)")"
  fi

  # Markdown pages (a .md, or a folder whose README is its index) come back rendered.
  local site_dir="$SITES/$name/$sub" md=0
  if ((app)); then
    :
  elif [[ "$page" =~ \.(md|markdown)$ ]]; then
    md=1
  elif [[ "$page" == */ && -d "$site_dir" && ! -f "$site_dir/index.html" ]] &&
    [[ -f "$site_dir/README.md" || -f "$site_dir/readme.md" || -f "$site_dir/index.md" ]]; then
    md=1
  fi
  if ((md)) && [[ "$code" == 200 ]]; then
    if grep -qF '<link rel="stylesheet" href="/_shared/' <<<"$body"; then ok "Markdown rendered"; else fail "Markdown not rendered"; fi
  fi

  # Same-origin links on the page (relative ones resolve against the page's folder).
  [[ "$code" == 200 ]] || body=""
  local pagedir="${page%%\?*}" link url lcode n=0 bad=0
  pagedir="${pagedir%/*}/"
  while read -r link; do
    [[ -n "$link" ]] || continue
    link="${link//&amp;/&}"
    link="${link%%#*}"
    [[ -n "$link" ]] || continue
    case "$link" in
      *://* | //* | mailto:* | data:* | javascript:* | tel:*) continue ;;
      /*)
        url="$base$link"
        [[ -z "$prefix" || "$link" == "/" || "$link" == /_shared/* || "$link" == "$prefix/"* ]] ||
          warn "absolute link $link leaves $prefix/ (breaks unless the app is served at the root$( ((app)) && echo ": --own-port"))"
        ;;
      *) url="$base$pagedir$link" ;;
    esac
    n=$((n + 1))
    lcode="$(curl -s --noproxy '*' -o /dev/null --max-time 15 -w '%{http_code}' "$url" || true)"
    if [[ "$lcode" =~ ^[23] ]]; then :; else fail "link $link → ${lcode:-no response}"; bad=$((bad + 1)); fi
  done < <(grep -oiE '(href|src)="[^"]*"' <<<"$body" | sed -E 's/^[^"]*"//; s/"$//' | awk '!seen[$0]++' | head -n 50)
  ((n == 0)) || ((bad)) || ok "$n link(s) on the page resolve"

  echo
  if ((fails)); then
    echo "$fails problem(s), $warns warning(s)"
    return 1
  fi
  echo "ok ($warns warning(s)): $(public_url "$name")$sub"
}

cmd_list() {
  local e name target port state lan kind extra
  echo "Sites:"
  local any=0
  for e in "$SITES"/*; do
    [[ -e "$e" || -L "$e" ]] || continue
    any=1
    name="$(basename "$e")"
    if [[ -L "$e" ]]; then
      target="$(readlink "$e")"
      if [[ -e "$e" ]]; then state=""; else state="  BROKEN"; fi
      printf '  %-20s -> %s%s\n' "$name" "$target" "$state"
    else
      printf '  %-20s (folder in lantern)\n' "$name"
    fi
  done
  ((any)) || echo "  (none)"

  echo
  echo "Apps:"
  any=0
  while read -r e; do
    any=1
    name="$(basename "$e")"
    port="$(app_port "$e")" lan="$(lan_port "$e")" kind="$(app_kind "$e")" extra=""
    state="$(systemctl --user is-active "lantern-app@$name" 2>/dev/null || true)"
    case "$kind" in
      tunnel) extra="ssh tunnel to $(app_var "$e" TUNNEL_TO) via $(app_var "$e" TUNNEL_VIA)" ;;
      proxy) port="-" state="-" extra="proxy to $(app_upstream "$e")" ;;
    esac
    [[ -z "$lan" ]] || extra+="${extra:+, }own port $lan"
    printf '  %-20s port %-6s %s%s\n' "$name" "${port:-?}" "${state:-unknown}" "${extra:+   $extra}"
  done < <(app_dirs)
  ((any)) || echo "  (none)"

  echo
  echo "Content repo: $LANTERN_CONTENT$([[ -d "$LANTERN_CONTENT" ]] || echo " (not created yet)")"
  echo "Served at $(url_for "" | sed 's|/*$|/|')"
}

cmd_reload() {
  validate || die "Caddyfile is invalid; not reloading"
  if unit_active lantern; then
    systemctl --user reload lantern
    echo "reloaded"
  else
    echo "config is valid; lantern.service is not running (systemctl --user start lantern)"
  fi
}

cmd_install() {
  local port="" caddy ver f
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="${2:-}"; shift 2 || die "usage: lantern install [--port N]" ;;
      *) die "usage: lantern install [--port N]" ;;
    esac
  done

  caddy="$(caddy_bin)"
  [[ -n "$caddy" ]] || die "caddy is not installed (see README → Setup)"
  ver="$(caddy_version "$caddy")"
  version_ge "$ver" "$MIN_CADDY" || die "caddy $ver is too old; need >= $MIN_CADDY"
  [[ "$LANTERN_ROOT" =~ [[:space:]] ]] && die "LANTERN_ROOT must not contain spaces: $LANTERN_ROOT"

  if [[ -n "$port" ]]; then
    [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1024 && port <= 65535)) || die "bad port: $port"
    set_local LANTERN_PORT "$port"
    LANTERN_PORT=$port
    echo "wrote lantern.env (LANTERN_PORT=$port)"
  fi

  validate || die "Caddyfile is invalid; not installing"

  mkdir -p "$UNIT_DIR"
  for f in lantern.service lantern-app@.service; do
    sed -e "s|@LANTERN_ROOT@|$LANTERN_ROOT|g" -e "s|@CADDY@|$caddy|g" \
      "$LANTERN_ROOT/systemd/$f" > "$UNIT_DIR/$f"
    echo "installed $UNIT_DIR/$f"
  done
  systemctl --user daemon-reload
  link_tool "$LANTERN_ROOT/bin/lantern" "$BIN_LINK"
  link_tool "$LANTERN_ROOT/skill" "$SKILL_LINK"

  if unit_active lantern; then
    systemctl --user restart lantern
    echo "restarted lantern.service"
  else
    systemctl --user enable --now lantern
    echo "enabled and started lantern.service"
  fi

  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]]; then
    echo
    echo "lantern stops when you log out. To keep it running:  loginctl enable-linger $USER"
  fi
  echo
  echo "Serving $(url_for "" | sed 's|/*$|/|')"
}

cmd_doctor() {
  local fails=0 warns=0 g="" y="" r="" z=""
  [[ -t 1 ]] && g=$'\e[32m' y=$'\e[33m' r=$'\e[31m' z=$'\e[0m'
  ok() { printf '  %s✓%s %s\n' "$g" "$z" "$*"; }
  warn() { printf '  %s!%s %s\n' "$y" "$z" "$*"; warns=$((warns + 1)); }
  fail() { printf '  %s✗%s %s\n' "$r" "$z" "$*"; fails=$((fails + 1)); }

  echo "Caddy"
  local caddy ver
  caddy="$(caddy_bin)"
  if [[ -z "$caddy" ]]; then
    fail "caddy not installed"
  else
    ver="$(caddy_version "$caddy")"
    if version_ge "$ver" "$MIN_CADDY"; then ok "caddy $ver ($caddy)"; else fail "caddy $ver is too old (need >= $MIN_CADDY)"; fi
    if validate 2>/dev/null; then ok "Caddyfile valid"; else fail "Caddyfile invalid: run bin/lantern reload to see errors"; fi
  fi

  echo "Service"
  local f
  for f in lantern.service lantern-app@.service; do
    if [[ ! -f "$UNIT_DIR/$f" ]]; then
      fail "$f not installed; run bin/lantern install"
    elif cmp -s <(sed -e "s|@LANTERN_ROOT@|$LANTERN_ROOT|g" -e "s|@CADDY@|$caddy|g" "$LANTERN_ROOT/systemd/$f") "$UNIT_DIR/$f"; then
      ok "$f installed"
    else
      warn "$f differs from systemd/$f; run bin/lantern install"
    fi
  done
  if unit_active lantern; then ok "lantern.service running"; else fail "lantern.service not running (journalctl --user -u lantern)"; fi
  if systemctl --user is-enabled --quiet lantern 2>/dev/null; then ok "lantern.service enabled"; else warn "lantern.service not enabled (won't start at boot)"; fi
  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" == "yes" ]]; then
    ok "linger enabled"
  else
    warn "linger disabled: lantern stops at logout (loginctl enable-linger $USER)"
  fi
  if port_listening "$LANTERN_PORT"; then
    ok "port $LANTERN_PORT listening"
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$LANTERN_PORT/" 2>/dev/null || true)"
    if [[ "$code" == 200 ]]; then ok "GET / → 200"; else fail "GET / → ${code:-no response}"; fi
  else
    fail "nothing listening on port $LANTERN_PORT"
  fi
  if grep -qs '^ENABLED=yes' /etc/ufw/ufw.conf; then
    warn "ufw is enabled: make sure the LAN may reach port $LANTERN_PORT (and $LAN_PORT_MIN-$LAN_PORT_MAX for apps on their own port), e.g. sudo ufw allow from <lan-subnet> to any port $LANTERN_PORT proto tcp"
  fi
  local link target
  for link in "$BIN_LINK:$LANTERN_ROOT/bin/lantern" "$SKILL_LINK:$LANTERN_ROOT/skill"; do
    target="${link#*:}" link="${link%%:*}"
    if [[ "$(readlink -f "$link" 2>/dev/null)" == "$(readlink -f "$target")" ]]; then
      ok "$link linked"
    else
      warn "$link is not linked to $target; run bin/lantern install"
    fi
  done
  if [[ -d "$LANTERN_CONTENT" ]]; then ok "content repo $LANTERN_CONTENT"; fi
  if [[ -n "${HTTPS_PROXY:-${https_proxy:-}}" ]] && ! grep -qsiE '^https_proxy=' "$LANTERN_ROOT/lantern.env"; then
    warn "your shell uses a proxy but app units won't: add HTTPS_PROXY/HTTP_PROXY/NO_PROXY to lantern.env so uv can install app dependencies"
  fi

  echo "Sites"
  local e name n=0
  for e in "$SITES"/*; do
    [[ -e "$e" || -L "$e" ]] || continue
    name="$(basename "$e")"
    n=$((n + 1))
    if [[ -L "$e" && ! -e "$e" ]]; then
      fail "$name: broken symlink -> $(readlink "$e")"
    elif [[ ! -L "$e" && "$name" != _* ]]; then
      warn "$name: is a real folder, not a symlink"
    elif [[ "$name" != _* ]] && ! valid_name "$name"; then
      warn "$name: not lowercase-kebab"
    fi
    [[ -e "$APPS/$name" ]] && fail "$name: is both a site and an app"
  done
  ok "$n site(s) checked"

  echo "Apps"
  local d port lan pl up rup kind state seen=" " seenlan=" " na=0
  while read -r d; do
    name="$(basename "$d")"
    na=$((na + 1))
    kind="$(app_kind "$d")" port="$(app_port "$d")" lan="$(lan_port "$d")"
    up="$(app_upstream "$d")" rup="$(route_upstream "$d")"
    [[ -f "$d/route.caddy" ]] || fail "$name: route.caddy missing (app is not routed)"
    if [[ "$kind" == proxy ]]; then
      valid_hostport "$up" || fail "$name: UPSTREAM is not <host>:<port>: $up"
    else
      [[ -x "$d/run.sh" ]] || fail "$name: run.sh missing or not executable"
      if [[ -z "$port" ]]; then
        fail "$name: no PORT in app.env"
      else
        [[ "$seen" == *" $port "* ]] && fail "$name: port $port used by another app"
        seen+="$port "
        ((port >= APP_PORT_MIN && port <= APP_PORT_MAX)) || warn "$name: port $port outside $APP_PORT_MIN-$APP_PORT_MAX"
      fi
    fi
    [[ -n "$rup" && -n "$up" && "$rup" != "$up" ]] && fail "$name: route.caddy proxies to $rup but app.env says $up"
    if [[ "$kind" != proxy ]] && grep -qE '^[[:space:]]*import lantern-proxy' "$d/route.caddy" 2>/dev/null; then
      warn "$name: route.caddy uses lantern-proxy for an app on 127.0.0.1, so it gets Host $up instead of the visitor's (import lantern-app $name $port)"
    fi
    if [[ -n "$lan" ]]; then
      [[ "$seenlan$seen" == *" $lan "* || "$lan" == "$LANTERN_PORT" ]] && fail "$name: own port $lan is used twice"
      seenlan+="$lan "
      ((lan >= LAN_PORT_MIN && lan <= LAN_PORT_MAX)) || warn "$name: own port $lan outside $LAN_PORT_MIN-$LAN_PORT_MAX"
      pl="$(caddy_lan_port "$d/port.caddy")"
      if [[ ! -f "$d/port.caddy" ]]; then
        fail "$name: LAN_PORT is set but port.caddy is missing"
      elif [[ -n "$pl" && "$pl" != "$lan" ]]; then
        fail "$name: port.caddy serves port $pl but app.env says $lan"
      fi
      pl="$(caddy_lan_port "$d/route.caddy")"
      [[ -n "$pl" && "$pl" != "$lan" ]] && fail "$name: route.caddy redirects to port $pl but app.env says $lan"
      unit_active lantern && ! port_listening "$lan" && warn "$name: nothing listening on own port $lan (lantern reload)"
    elif [[ -f "$d/port.caddy" ]]; then
      fail "$name: has port.caddy but no LAN_PORT in app.env"
    fi
    if [[ "$kind" == proxy ]]; then
      ok "$name: proxies to $up (lantern doesn't run it)"
      continue
    fi
    state="$(systemctl --user is-active "lantern-app@$name" 2>/dev/null || true)"
    if [[ "$state" == active ]]; then
      if [[ -n "$port" ]] && ! port_listening "$port"; then
        warn "$name: running but nothing listening on $port$([[ "$kind" != tunnel ]] || echo " (ssh tunnel not up yet?)")"
      else
        ok "$name: running on $port$([[ "$kind" != tunnel ]] || echo ", ssh tunnel to $(app_var "$d" TUNNEL_TO)")"
      fi
    else
      warn "$name: not running (systemctl --user enable --now lantern-app@$name)"
    fi
  done < <(app_dirs)
  ((na)) || ok "no apps"

  echo
  if ((fails)); then
    echo "$fails problem(s), $warns warning(s)"
    return 1
  fi
  echo "all good ($warns warning(s))"
}

usage() {
  cat <<EOF
usage: lantern <command> [args]

  add-site <name> <path> [--dry-run] [--whole-repo]
                           serve <path> at /<name>/ (creates a symlink in sites/);
                           lists what becomes readable; refuses a repo root unless --whole-repo
  new-site <name> [dir]    create <dir> (default: content repo pages/<name>) with a stub README, serve it
  rm-site <name>           remove a site (the symlink only)
  add-app <name> [port] [--keep-prefix | --own-port]
                           scaffold apps/<name>/ with the next free port; --keep-prefix for apps
                           that serve under /<name>/ themselves (Streamlit, marimo, Dash, …);
                           --own-port serves the app at the root of its own LAN port (8201-8299)
                           instead, for apps with absolute URLs (device UIs, vendor dashboards)
  add-tunnel <name> <ssh-host> <host:port> [--keep-prefix | --own-port]
                           an app whose run.sh is an ssh tunnel to <host:port> as <ssh-host>
                           sees it (user@host, ssh://user@host:port or a ~/.ssh/config alias)
  add-proxy <name> <host:port> [--keep-prefix | --own-port]
                           proxy a plain-HTTP service lantern doesn't start: one elsewhere, or
                           one already running here (127.0.0.1:<port>); no unit
  rm-app <name> [--force]  stop and disable the app's unit, remove apps/<name>/
  check <name>[/<page>]    live check of a site or app, or one page of it: answers, Markdown
                           renders, same-origin links on it resolve
  list                     sites (-> targets) and apps (port, status, tunnel/proxy, own port)
  content                  print the content repo path (creates it on first use)
  reload                   validate the Caddyfile, then reload Caddy
  doctor                   check caddy, service, port, links and apps
  install [--port N]       install/refresh the systemd user units, link ~/.local/bin/lantern and
                           the Claude skill, start lantern
EOF
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  add-site) cmd_add_site "$@" ;;
  new-site) cmd_new_site "$@" ;;
  rm-site) cmd_rm_site "$@" ;;
  add-app) cmd_add_app "$@" ;;
  add-tunnel) cmd_add_tunnel "$@" ;;
  add-proxy) cmd_add_proxy "$@" ;;
  rm-app) cmd_rm_app "$@" ;;
  check) cmd_check "$@" ;;
  list | ls) cmd_list "$@" ;;
  content) cmd_content "$@" ;;
  reload) cmd_reload "$@" ;;
  doctor) cmd_doctor "$@" ;;
  install) cmd_install "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 1 ;;
esac
